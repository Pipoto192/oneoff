# ==========================================================================
# OneOff / Music Imposter - Server-Konfiguration (VORLAGE)
# --------------------------------------------------------------------------
# Diese Datei enthaelt AUSSCHLIESSLICH Platzhalter - KEINE echten Werte.
# Sie darf und soll committed werden; die echte .env darf NIEMALS ins Repo
# (ist per .gitignore ausgeschlossen, siehe docs/repo-cleanup.md).
#
# Verwendung:
#   Copy-Item .env.example music-imposter-app\server\.env
#   # dann .env oeffnen und die echten Werte eintragen
# Der Server liest die .env aus seinem Arbeitsverzeichnis
# (music-imposter-app/server/.env, siehe require('dotenv').config()).
# ==========================================================================

# --- Spotify (Developer Dashboard: https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Muss exakt der im Spotify-Dashboard hinterlegten Redirect URI entsprechen
SPOTIFY_REDIRECT_URI=http://localhost:3001/callback

# --- URL des Web-Clients (Redirect nach dem Spotify-Login)
CLIENT_URL=http://localhost:3000

# --- MongoDB Atlas Connection String (DB-User + Passwort eintragen)
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@CLUSTER.mongodb.net/DB_NAME?retryWrites=true&w=majority

# --- Port des Express-/-Socket.io-Servers
PORT=3001

# --- Hinweis Client (Next.js): NEXT_PUBLIC_SERVER_URL
# Die Client-App nutzt NEXT_PUBLIC_SERVER_URL als Server-URL und faellt sonst
# auf die produktive Koyeb-URL zurueck (client/src/app/page.js:20). Fuer
# lokale Builds z. B.:
# NEXT_PUBLIC_SERVER_URL=http://localhost:3001
