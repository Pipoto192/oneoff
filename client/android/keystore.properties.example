# ==========================================================================
# OneOff - Android signing credentials (TEMPLATE - contains NO real values)
# --------------------------------------------------------------------------
# Copy this file to client/android/keystore.properties and fill in the real
# values, then build as usual. client/android/app/build.gradle reads it via
#   rootProject.file('keystore.properties')
#
# keystore.properties is matched by .gitignore ("keystore.properties") and
# must NEVER be committed. Never put a password into build.gradle either.
#
# storeFile is resolved relative to client/android/app/ (the module dir),
# so "upload-keystore.jks" points at client/android/app/upload-keystore.jks.
#
# The previous upload key was committed to a PUBLIC repository together with
# its plaintext password and must be treated as compromised:
#   1) keytool -genkey -v -keystore upload-keystore.jks -alias upload ^
#        -keyalg RSA -keysize 2048 -validity 10000
#   2) Google Play Console -> Release -> Setup -> App signing ->
#      "Reset your play app signing key" and upload the new certificate.
# ==========================================================================
storeFile=upload-keystore.jks
keyAlias=upload
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
